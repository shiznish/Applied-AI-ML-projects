# Copy to .env and fill in ONE of the provider keys below.
# Provider is auto-detected: GROQ_API_KEY set -> groq, else -> anthropic.
# Override with LLM_PROVIDER=groq|anthropic|openai_compatible

# Free tier, no card needed — get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Paid — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# AWS Bedrock — requires LLM_PROVIDER=bedrock (not auto-detected) and
# TEXT2SQL_MODEL set to a Bedrock model id or inference profile ARN.
# LLM_PROVIDER=bedrock
# TEXT2SQL_MODEL=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional overrides
# TEXT2SQL_MODEL=llama-3.3-70b-versatile   (groq default) | claude-sonnet-5 (anthropic default)
# LLM_BASE_URL=                            (for LLM_PROVIDER=openai_compatible: Gemini/OpenRouter/Ollama endpoints)
# LLM_API_KEY=                             (key for openai_compatible)
# PostgreSQL: `docker compose up -d` starts one locally on these defaults.
DATABASE_URL=postgresql://text2sql:text2sql@localhost:5432/text2sql
# Only used by data/seed.py / app/db/policies.sql to create roles & RLS policies;
# defaults to DATABASE_URL if unset. Use a superuser/owner DSN here in a real
# deployment so the app's own runtime connection never needs elevated rights.
DATABASE_ADMIN_URL=
TEXT2SQL_ROW_LIMIT=1000
TEXT2SQL_QUERY_TIMEOUT_S=10
