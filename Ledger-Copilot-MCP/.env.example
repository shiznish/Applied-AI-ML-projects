# Copy to .env.local for local overrides (gitignored) — .env.local takes
# precedence over .env. In production, these are set as real environment
# variables by the platform (Azure Container Apps/App Service Key Vault
# references, or an AKS ExternalSecret — see deploy/k8s/), never from a file.

LEDGER_COPILOT_ENVIRONMENT=development
LEDGER_COPILOT_LOG_LEVEL=INFO
LEDGER_COPILOT_HOST=0.0.0.0
LEDGER_COPILOT_PORT=8000

LEDGER_COPILOT_AUDIT_DATABASE_PATH=:memory:

LEDGER_COPILOT_VENDOR_RISK_API_BASE_URL=https://api.opensanctions.org
# Secret in production — see deploy/k8s/external-secret.example.yaml
LEDGER_COPILOT_VENDOR_RISK_API_KEY=
LEDGER_COPILOT_VENDOR_RISK_TIMEOUT_SECONDS=5.0
LEDGER_COPILOT_VENDOR_RISK_MAX_RETRIES=3
LEDGER_COPILOT_VENDOR_RISK_CIRCUIT_FAILURE_THRESHOLD=5
LEDGER_COPILOT_VENDOR_RISK_CIRCUIT_COOLDOWN_SECONDS=30.0

# Leave AUTH_JWKS_URI unset for the unauthenticated local-demo mode. Set all
# three to require a real OAuth2.1 bearer token (see README's "Security"
# section). Secrets in production — see deploy/k8s/external-secret.example.yaml
LEDGER_COPILOT_AUTH_JWKS_URI=
LEDGER_COPILOT_AUTH_ISSUER=
LEDGER_COPILOT_AUTH_AUDIENCE=
LEDGER_COPILOT_AUTH_ALGORITHM=RS256

LEDGER_COPILOT_RATE_LIMIT_CAPACITY=20.0
LEDGER_COPILOT_RATE_LIMIT_REFILL_PER_SECOND=10.0
